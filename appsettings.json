{
  // The repository path is detected from where the server starts; set "RepositoryPath" only to point elsewhere.
  // Everything else can stay as is.
  "LiteDbConnectionString": "Filename=sph.db;Connection=shared;",
  "Port": "25860",
  "LogPath": "logs/server.log",
  "DebugMode": "true",

  // Logins allowed to use GM commands, comma separated. Empty means nobody.
  // To create your own GM account: put your login here, set GmAccountBootstrap to true, log in once to create it,
  // then set GmAccountBootstrap back to false.
  "GmAccounts": "",
  "GmAccountBootstrap": "false",

  "AllowSelfAttack": "false",
  "MobChaseEnabled": "true",
  "GameClockSync": "false",
  "CityMonsterProtection": "true",
  "CityProtectionRadiusMeters": "150.0",
  "ObjectVisibilityDistance": "100.0",
  "ReceiveBufferSize": "1024",
  "CurrentCharacterInventoryId": "40961",
  "Spawn_X": "422",
  "Spawn_Y": "153.0",
  "Spawn_Z": "-1284.0",
  "Spawn_Angle": "0.75",
  "Spawn_Money": "99999999",
  "GeneratedJsonOutputFolder": ".generated",
  "DecodedParamsFolderName": "params",
  "DecodedLocaleFolderName": "language",
  "ObjectDataFileName": "objectData.json",
  "SuffixDataFileName": "suffixData.json",
  "LocalizationContentFileName": "localizationContent.json",
  "ObjectLocalizationFileName": "objectLocalization.json",

  // Auto-updater of exported builds. Point these at your own releases; the defaults of the original project were
  // removed so a fork never downloads someone else's code by accident.
  "AssetPacksReleaseBaseUrl": "",
  "GithubRepo": "mathbrz/SphereEmu-BR",
  "UpdateTipReleaseTag": "windows-debug-slim"
}
